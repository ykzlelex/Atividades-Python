programa
{
	
	funcao inicio()
	{
		inteiro i,quantidade
		cadeia nome
		real salario, soma,salariomalto, salariombaixo
		 escreva("quantidade de funcionarios: ")
		 leia(quantidade)
		 i = 1
		 soma = 0
		 enquanto (i<=quantidade){
		 	escreva("nome? ")
		 	leia(nome)
		 	escreva ("salario: ")
		 }
		 soma = soma + salario
		 }
	}
}
